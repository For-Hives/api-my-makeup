HOST=0.0.0.0
PORT=1337
APP_KEYS=key1,key2
API_TOKEN_SALT=salt_key
ADMIN_JWT_SECRET=secret
JWT_SECRET=secret

# Origins allowed to call the API from a browser, comma separated.
# Default (unset): https://my-makeup.fr,https://www.my-makeup.fr
CORS_ORIGINS=http://localhost:3000

# Emails (forgotten password): Resend (SMTP) when RESEND_API_KEY is set,
# otherwise Mailgun when both MAILGUN_* are set (EU region unless
# MAILGUN_REGION=us), otherwise Strapi's default provider.
#RESEND_API_KEY=
#MAILGUN_API_KEY=
#MAILGUN_DOMAIN=mg.my-makeup.fr
#MAILGUN_REGION=eu
# Resend defaults; with Resend, the sender must use send.my-makeup.fr
#EMAIL_FROM="My Makeup <no-reply@send.my-makeup.fr>"
#EMAIL_REPLY_TO=contact@my-makeup.fr
# Link of the reset email, followed by ?code=<token>
#FRONT_RESET_PASSWORD_URL=https://my-makeup.fr/auth/reinitialiser
# false: leave the users-permissions email settings as the admin set them
#EMAIL_SETTINGS_SYNC=true

# Daily sweep (04:00, Paris time) of the pictures sent from the artist space
# and never put on a profile for 24 h: delete (default) removes at most 50
# per run (database and R2), log only logs their count and ids, off does
# nothing. Files sent by the admin or before uploaded_by are never touched.
#MEDIA_SWEEP=delete
# false: no scheduled task at all
#CRON_ENABLED=true


CF_ACCESS_KEY_ID=.....
CF_ACCESS_SECRET=...
CF_BUCKET=my-makeup
CF_ENDPOINT=https://......r2.cloudflarestorage.com
CF_PUBLIC_ACCESS_URL=https://r2-.....



// DEV
DB_CLIENT='sqlite'
DB_FILENAME=".tmp/data.db"


// PROD
DB_CLIENT='postgres'
DATABASE_HOST='localhost'
DATABASE_PORT=5432
DATABASE_NAME='name'
DATABASE_USERNAME='postgres'
DATABASE_PASSWORD='0000'

